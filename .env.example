# Copy to .env and adjust. docker compose reads .env automatically.
# For local (non-Docker) runs, export the variables in your shell instead.
# Never commit a real .env - it is git-ignored.

# --- docker compose -----------------------------------------------------------
LOG_LEVEL=INFO
# How often the API checks the registry for a new @champion (seconds).
MODEL_RELOAD_INTERVAL_SECONDS=10
# Monitoring cadence (seconds) and minimum gap between automated retrains (minutes).
MONITOR_INTERVAL_SECONDS=30
RETRAIN_COOLDOWN_MINUTES=2
# When set, POST /model/reload requires the header X-Admin-Token: <value>.
ADMIN_TOKEN=
# Grafana admin login (anonymous read-only access is enabled for the dashboard).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- application (both Docker and local) --------------------------------------
# Tracking server / store. Defaults to sqlite:///mlflow.db locally and to
# http://mlflow:5000 inside docker compose.
# MLFLOW_TRACKING_URI=http://localhost:5000
# Alternative config file (defaults to configs/config.yaml).
# MLOPS_CONFIG=configs/config.yaml
# Any config key can be overridden as MLOPS__<SECTION>__<KEY>, e.g.:
# MLOPS__TRAINING__CV_FOLDS=3
# MLOPS__MONITORING__DRIFT__PSI_THRESHOLD=0.25
# Log format: text (default locally) or json (default in the container image).
# LOG_FORMAT=json
MLFLOW_DISABLE_TELEMETRY=true

# --- optional S3 publishing (data snapshots + monitoring reports) -------------
# MLOPS__STORAGE__S3__ENABLED=true
# MLOPS__STORAGE__S3__BUCKET=my-mlops-bucket
# MLOPS__STORAGE__S3__ENDPOINT_URL=http://localhost:9000   # only for S3-compatible stores
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
